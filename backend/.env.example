PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=skilllink_db
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
FRONTEND_URL=http://localhost:5173

# Optional comma-separated extra allowed browser origins
FRONTEND_URLS=

# Local development only; seed scripts refuse production and Railway databases
ALLOW_DESTRUCTIVE_SEED=false
SEED_USER_PASSWORD=
ALLOW_DB_TESTS=false
